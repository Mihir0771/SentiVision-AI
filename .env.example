# ============================================================
# SentiVision AI — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in production values.
# Lines starting with # are comments and are ignored.
# ============================================================

# Flask environment: development | production | testing
FLASK_ENV=development

# Set to 1 to enable Flask debug / auto-reload (development only)
FLASK_DEBUG=1

# Secret key for session signing and CSRF protection.
# Generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Secret key for JWT token generation and verification.
JWT_SECRET_KEY=change-me-to-a-jwt-secret-key

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/sentiment_analyzer

# Absolute path to the upload directory.
# Leave empty to use the default (<app_root>/uploads).
UPLOAD_FOLDER=

# Maximum upload size in bytes (default: 16 MB = 16777216).
MAX_CONTENT_LENGTH=16777216

# Server bind settings (used by run.py).
HOST=0.0.0.0
PORT=5000
